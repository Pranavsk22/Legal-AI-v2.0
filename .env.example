# Groq API Keys for Legal AI
# Get your keys from the Groq console (https://console.groq.com)

# API key for summarizing long-form legal documents/contracts
GROQ_API_KEY_SUMMARY=gsk_your_summary_key_here

# API key for interactive contract Q&A
GROQ_API_KEY_QA=gsk_your_qa_key_here

# Model ID to use (defaults to 'groq/compound')
# Options include: groq/compound, groq/compound-mini, qwen/qwen3.6-27b, allam-2-7b
GROQ_MODEL_ID=groq/compound
